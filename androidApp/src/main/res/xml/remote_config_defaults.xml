<?xml version="1.0" encoding="UTF-8"?>
<!--
    Content sync keys (herb_model_url, herb_model_sha256, herb_catalog_url, herb_catalog_sha256)
    have no default: Remote Config rejects empty values here, and an unset key reads as "", which
    means "nothing published, use the bundled copy". See docs/content-publishing.md.
-->
<defaults>
    <!-- Version codes; 0 means no update prompt -->
    <entry>
        <key>min_supported_version_android</key>
        <value>0</value>
    </entry>
    <entry>
        <key>recommended_version_android</key>
        <value>0</value>
    </entry>
    <!-- true shows the "service unavailable" notice and closes the app -->
    <entry>
        <key>service_suspended</key>
        <value>false</value>
    </entry>
</defaults>
