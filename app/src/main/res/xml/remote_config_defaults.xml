<?xml version="1.0" encoding="UTF-8"?>
<!-- Empty values mean "nothing published": the app uses its bundled model and catalog. -->
<defaults>
    <entry>
        <key>herb_model_url</key>
        <value></value>
    </entry>
    <entry>
        <key>herb_model_sha256</key>
        <value></value>
    </entry>
    <entry>
        <key>herb_catalog_url</key>
        <value></value>
    </entry>
    <entry>
        <key>herb_catalog_sha256</key>
        <value></value>
    </entry>
    <!-- Version codes; 0 means no update prompt -->
    <entry>
        <key>min_supported_version_android</key>
        <value>0</value>
    </entry>
    <entry>
        <key>recommended_version_android</key>
        <value>0</value>
    </entry>
</defaults>
