{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "./gradlew",
      "runtimeArgs": [
        ":webApp:jsBrowserDevelopmentRun"
      ],
      "port": 8080
    },
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8090",
        "--directory",
        "webApp/build/site"
      ],
      "port": 8090
    }
  ]
}