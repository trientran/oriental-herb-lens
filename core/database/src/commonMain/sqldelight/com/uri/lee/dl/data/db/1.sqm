ALTER TABLE species ADD COLUMN phylum TEXT NOT NULL DEFAULT '';
ALTER TABLE species ADD COLUMN class_name TEXT NOT NULL DEFAULT '';
ALTER TABLE species ADD COLUMN order_name TEXT NOT NULL DEFAULT '';
ALTER TABLE species ADD COLUMN rank TEXT NOT NULL DEFAULT '';
ALTER TABLE species ADD COLUMN taxonomic_status TEXT NOT NULL DEFAULT '';
ALTER TABLE species ADD COLUMN published_in TEXT NOT NULL DEFAULT '';
ALTER TABLE species ADD COLUMN basionym TEXT NOT NULL DEFAULT '';

