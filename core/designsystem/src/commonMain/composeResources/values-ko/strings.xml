    <!-- Tips on AI terms (InfoTip): a title and a plain explanation each -->
    <string name="term_ai_model">AI 모델</string>
    <string name="term_ai_model_body">많은 예시 사진으로 패턴을 알아보는 법을 배운 프로그램입니다. Med Herb Lens는 모델을 사용해 사진 속 식물의 이름을 알려 줍니다. 모델은 학습한 것만 알고 있으며 틀릴 수 있습니다.</string>
    <string name="term_image_classification">이미지 분류</string>
    <string name="term_image_classification_body">사진 전체를 보고 정해진 목록에서 가장 잘 맞는 이름을, 얼마나 확신하는지를 나타내는 백분율과 함께 고르는 AI의 한 종류입니다. 목록 밖의 이름을 말하거나, 사진의 어디에 무엇이 있는지 보여 주거나, 사진을 설명할 수는 없습니다.</string>
    <string name="term_confidence">신뢰도(%)</string>
    <string name="term_confidence_body">모델이 어떤 이름을 얼마나 확신하는지를 0에서 100%로 나타낸 것입니다. 모델 자체의 추정이지 보장이 아닙니다. 모델은 매우 확신하면서도 틀릴 수 있으며, 특히 학습하지 않은 식물에서 그렇습니다. 프로필에서 설정한 최소 신뢰도보다 낮은 결과는 표시되지 않습니다.</string>
    <string name="term_identify_modes">‘전체 화면’과 ‘식물 선택’</string>
    <string name="term_identify_modes_body">‘전체 화면’은 사진 전체를 한 번에 식별합니다. ‘식물 선택’은 먼저 사진 속 개별 식물을 찾아(객체 탐지) 점으로 표시한 다음, 그 식물만 식별합니다. 여러 식물이 보일 때 유용합니다.</string>
    <string name="term_base_model">품질: 모델의 기반</string>
    <string name="term_base_model_body">내 모델은 일반적인 모양, 색, 질감을 이미 알아보는 기성 이미지 모델을 기반으로 합니다. 내 사진에서 배우는 것은 마지막 단계, 즉 내 종을 구별하는 것뿐이라서 사진 수십 장이면 충분합니다. ‘가장 정확’은 DINOv2(Meta 제작)를 사용합니다. 훨씬 정확하지만 사진 한 장을 읽는 데 더 오래 걸리고(최신 iPhone에서 약 0.1초, 중급형 휴대폰에서 약 1초), 처음에는 23MB를 다운로드해야 합니다. ‘빠름’은 작은 MobileNet(Google MediaPipe 제작)을 사용합니다. 빠르지만 덜 정확합니다. 이전에 ‘균형’이나 ‘최고’로 만든 모델은 만들 때 사용한 더 큰 MobileNet을 그대로 사용합니다.</string>
    <string name="term_training">학습</string>
    <string name="term_training_body">예시로 모델을 가르치는 것입니다. 종별로 분류한 사진을 주면, 라운드를 거듭하며 스스로 조정해 구별할 수 있게 됩니다. 여기서는 모든 과정이 기기에서 이루어지며 사진은 업로드되지 않습니다.</string>
    <string name="term_round">라운드(에포크)</string>
    <string name="term_round_body">모든 학습 사진을 한 번씩 훑어보는 것입니다. 각 라운드 후 검증 사진으로 모델을 확인합니다. 더 이상 나아지지 않거나 최대 라운드 수에 도달하면 학습이 멈춥니다.</string>
    <string name="term_checking_photos">검증 사진(검증 데이터)</string>
    <string name="term_checking_photos_body">따로 떼어 두고 학습에는 절대 쓰지 않는 사진 일부입니다. 각 라운드 후 이 사진으로 모델을 시험해, 처음 보는 사진에서 얼마나 잘하는지 보고 언제 멈출지 정합니다.</string>
    <string name="term_test_accuracy">처음 보는 사진에서의 정확도</string>
    <string name="term_test_accuracy_body">따로 떼어 두고 학습에 쓰지 않은 테스트 사진 중 완성된 모델이 이름을 맞힌 비율입니다. 새 사진이 학습에 쓴 사진과 비슷하다면, 새 사진에서의 성능을 가늠하는 가장 좋은 지표입니다.</string>
    <string name="term_loss">오류(손실)</string>
    <string name="term_loss_body">모델의 답이 얼마나 틀렸는지를, 얼마나 확신했는지까지 반영해 나타낸 수치입니다. 낮을수록 좋습니다. 학습 사진에서의 오류는 계속 줄어드는데 검증 사진에서의 오류가 늘어나면, 모델이 배우는 대신 사진을 외우고 있는 것입니다(과적합).</string>
    <string name="term_confusion">혼동 행렬</string>
    <string name="term_confusion_body">테스트 사진의 표입니다. 각 행은 사진에 실제로 있는 종이고, 각 열은 모델이 답한 종입니다. 대각선의 숫자는 맞힌 답이고, 나머지는 어떤 종을 혼동하는지 보여 줍니다.</string>
    <string name="term_continual">‘계산’, ‘이전 것 유지’, ‘모두 다시 학습’</string>
    <string name="term_continual_body">‘계산’은 모든 사진에서 모델을 구합니다. 각 종의 평균 사진과, 모든 종에 공통된 사진의 변화 방식을 사용합니다. 학습 라운드가 없어서 금방 끝나고 절대 잊지 않으며, 저희 테스트에서 가장 정확했습니다. 나중에 종이나 사진을 추가하면 ‘이전 것 유지’는 새 사진과 이전 사진 일부로 학습하므로 빠르고 알던 것을 잊지 않습니다(연속 학습). ‘모두 다시 학습’은 모든 사진으로 처음부터 다시 시작합니다. 더 느리지만 가끔 조금 더 정확합니다.</string>
    <string name="term_learning_rate">학습률</string>
    <string name="term_learning_rate_body">모델이 스스로 고칠 때마다 내딛는 걸음의 크기입니다. 너무 크면 자리 잡지 못하고 이리저리 튀고, 너무 작으면 아주 느리게 배웁니다.</string>
    <string name="term_batch_size">배치 크기</string>
    <string name="term_batch_size_body">모델이 한 번 고치기 전에 보는 사진 수입니다. 배치가 클수록 걸음이 안정적이고, 작을수록 적은 사진에서 더 많이 배울 수 있습니다.</string>
    <string name="term_early_stopping">조기 종료</string>
    <string name="term_early_stopping_body">검증 사진의 성능이 이 라운드 수만큼 나아지지 않으면 학습이 멈추고, 가장 좋았던 라운드가 채택됩니다. 모델이 사진을 외우는 것을 막아 줍니다.</string>
    <string name="term_weight_decay">가중치 감쇠(L2)</string>
    <string name="term_weight_decay_body">모델의 숫자를 작게 유지하는 부드러운 힘으로, 몇몇 사진의 특이점이 아니라 일반적인 패턴에 의존하게 합니다. 값이 클수록 외우기를 더 잘 막습니다.</string>
    <string name="term_seed">시드</string>
    <string name="term_seed_body">어떤 사진을 떼어 둘지 등 학습 중 무작위 선택의 출발점이 되는 숫자입니다. 같은 시드와 같은 사진이면 같은 모델이 나오므로 결과를 재현할 수 있습니다.</string>
    <string name="term_hidden_layer">은닉층</string>
    <string name="term_hidden_layer_body">기반 모델과 답 사이에 있는 추가 유닛 층으로, 모델이 더 복잡한 차이를 배울 수 있게 합니다. 0은 없음을 뜻하며, 더 단순하고 빠르고 보통은 그것으로 충분합니다.</string>
    <string name="term_class_balance">종 균형 맞추기</string>
    <string name="term_class_balance_body">일부 종의 사진이 훨씬 적으면 모델이 다른 종을 선호하는 경향이 있습니다. 균형 맞추기는 드문 종의 사진 한 장에 더 큰 가중치를 주어 모든 종이 같은 비중을 갖게 합니다.</string>
    <string name="term_tflite">TensorFlow Lite 파일(.tflite)</string>
    <string name="term_tflite_body">휴대폰 등 작은 기기에서 실행되는 AI 모델의 표준 파일 형식입니다. 이렇게 저장되고 종 목록이 들어 있는 모델은 Med Herb Lens뿐 아니라 TensorFlow Lite 모델을 실행하는 다른 앱에서도 작동합니다.</string>
    <string name="term_hugging_face">Hugging Face</string>
    <string name="term_hugging_face_body">연구자와 개발자가 AI 모델을 공유하는 공개 웹사이트입니다. 그곳에 게시하면 다른 사람이 내 모델을 찾고, 다운로드하고, 인용할 수 있습니다.</string>
    <string name="tip_open">이게 무엇인가요: %1$s?</string>
    <string name="tip_got_it">알겠습니다</string>
    <string name="details_map_note">사진 위치는 사진을 공유한 사람이 제공한 것으로 확인되지 않았으므로 정확하지 않을 수 있습니다.</string>
    <string name="train_intro_title">‘학습’은 무엇에 쓰나요?</string>
    <string name="train_intro_body">‘학습’은 내가 고른 것들을 구별하는 나만의 AI 모델을 내 사진으로 만듭니다. 식물 전용이 아닙니다. 사진으로 무언가를 구별할 수 있는 분야라면 어디서든 쓸 수 있습니다. 예를 들어 농업(수확한 토마토의 품질 등급 매기기), 임업, 바이오 보안(해충, 병, 잡초 발견), 의학 교육과 연구 등이 있습니다. 학습은 이 기기에서 실행됩니다.\n\n지금은 이미지 분류 모델만 만들 수 있습니다. 사진이 내 범주(종, 등급, 상태) 중 무엇을 보여 주는지 말해 주는 모델입니다. 학습시킨 모델은 학습과 연구를 위한 것입니다. 진단이나 음식의 안전 여부처럼 전문가가 필요한 결정에 이 모델에만 의존하지 마세요.</string>
    <string name="train_intro_steps">모델 이름을 정하고, 범주마다 사진을 추가해 학습시킨 다음, 카메라로 사용해 보세요.</string>

    <!-- Research survey invitation: the recruitment letter approved by UNE HREC, adapted only to say the app is on more than Android, to name the button instead of a link, and to give the email address -->
    <string name="survey_title">연구 설문조사</string>
    <string name="survey_row_body">약 10~15분, 익명</string>
    <string name="survey_letter">Dear friends,\n\nI hope this message finds you well. My name is Trien Phat Tran, and I am currently pursuing my PhD in Computer Science at the University of New England (Australia), under the guidance of Dr. Fareed Ud Din, Professor Ljiljana Brankovic, Professor Cesar Sanin, and Associate Professor Susan Hester.\n\nI am writing to invite you to participate in an important phase of my PhD research. My study focuses on developing a mobile application for identifying Vietnamese medicinal plants using deep learning and crowdsourced data. Our goal is to create a user-friendly app that leverages community-contributed data to train and optimize deep learning models, ensuring accurate and safe identification of medicinal plants.\n\nTo ensure the success of this project, I am conducting an online survey to gather insights and feedback from individuals with knowledge and experience in this field. Your participation would be invaluable in helping us better understand the needs and expectations of users for this application.\n\nThe survey includes questions about:\n• User interface and experience of the mobile application.\n• Suggest new features that could benefit your work or field of expertise.\n• Effectiveness and clarity of the plant identification process.\n• Methods for crowd-sourcing data and user engagement strategies.\n\nThe survey will take approximately 10-15 minutes to complete. We greatly appreciate your time and contribution to this research. Your feedback will play a crucial role in refining and enhancing the quality of the application.\n\nPlease tap Take the survey below to begin.\n\nIf you have any questions or require further information, please do not hesitate to contact me at ttran72@myune.edu.au. I look forward to receiving your response and sincerely thank you for your support.\n\nBest Regards,\n\nTrien Phat Tran\nPhD Candidate - Computer Science\nUniversity of New England</string>
    <string name="survey_start">설문조사 참여하기</string>
    <string name="survey_not_now">나중에</string>
    <string name="survey_close">닫기</string>
    <string name="profile_contributions">내 기여</string>
    <string name="profile_contributions_empty">공유한 내용이 여기에 표시됩니다: 약초 사진, 제안한 이름, 공유한 모델. ‘사진 필요’로 표시된 약초의 사진이 모델에 가장 도움이 됩니다.</string>
