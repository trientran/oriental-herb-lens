    <string name="profile_contributions_species">촬영한 종</string>
    <string name="profile_contributions_names">제안한 이름</string>
    <string name="profile_contributions_models">공유한 모델</string>
    <string name="profile_contributions_adds">다른 사람이 내 모델을 추가한 횟수</string>
    <string name="profile_badges">배지</string>
    <string name="profile_badges_note">나만 볼 수 있습니다. 기여는 삭제되지 않고 %1$d일 동안 공유되면 집계됩니다.</string>
